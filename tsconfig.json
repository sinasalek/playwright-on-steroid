{
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es6",
    "baseUrl": "./", // Set baseUrl to your project root
    "paths": {
      "@/*": ["./*"] // Map @/ to the root directory
    }
  },
  "include": ["./**/*"],
  "exclude": ["node_modules"]
}